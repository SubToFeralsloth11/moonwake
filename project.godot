; Engine configuration file.
config_version=5

[application]

config/name="Moonwake"
config/description="A tide-turning card game set in a moonlit harbor."
run/main_scene="res://scenes/hub/hub.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[autoload]

Profile="*res://scripts/core/profile.gd"
Game="*res://scripts/core/game.gd"
Sfx="*res://scripts/core/sfx.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[physics]

common/physics_ticks_per_second=60

[rendering]

anti_aliasing/quality/msaa_3d=2
anti_aliasing/quality/screen_space_aa=1
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
